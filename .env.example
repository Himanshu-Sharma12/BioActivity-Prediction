# Add your Gemini API key here
# Get it from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Optional: Python RDKit sidecar (see sidecar/README.md) ---
# Unlocks the complete RDKit FilterCatalog (PAINS_A/B/C, BRENK, NIH, CHEMBL, ZINC),
# the QED drug-likeness score, and Murcko scaffolds — none of which RDKit's WASM
# MinimalLib build exposes.
#
# OPTIONAL. Leave it unset and the app behaves exactly as it does without the sidecar,
# using the built-in 31-pattern Brenk/PAINS subset. No network call is attempted when
# this is unset.
#
# RDKIT_SIDECAR_URL=http://127.0.0.1:8000
